generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── RBAC ───────────────────────────────────────────
model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // Admin, Manager, User, Vendor
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  phone        String?
  department   String?
  isActive     Boolean  @default(true)
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  vendorId     Int?     @unique  // Links user to vendor account (for vendor role users)
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseRequests PurchaseRequest[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  chatMessages     ChatMessage[]
  returnOrders     ReturnOrder[]

  @@index([email])
  @@index([roleId])
}

// ─── VENDORS ────────────────────────────────────────
model Vendor {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  phone           String?
  address         String?
  gstNumber       String?
  rating          Float    @default(0)
  status          String   @default("Active") // Active, Inactive, Blocked
  isBlacklisted   Boolean  @default(false)
  performanceScore Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User?   // Link to user account for portal access
  purchaseOrders PurchaseOrder[]
  products       ProductVendor[]
  quotations     Quotation[]
  vendorQuotes   VendorQuote[]
  portalActions  VendorPortalAction[]
  rfqInvitations RFQVendor[]  // RFQs this vendor is invited to

  @@index([status])
}

// ─── PRODUCTS & CATEGORIES ──────────────────────────
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String   @unique
  description String?
  unit        String   @default("pcs") // pcs, kg, liters, etc.
  price       Float    @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inventory            Inventory?
  purchaseRequestItems PurchaseRequestItem[]
  orderItems           OrderItem[]
  warranties           Warranty[]
  vendors              ProductVendor[]
  quotationItems       QuotationItem[]

  @@index([sku])
  @@index([categoryId])
}

model ProductVendor {
  id        Int     @id @default(autoincrement())
  productId Int
  vendorId  Int
  price     Float   @default(0)
  product   Product @relation(fields: [productId], references: [id])
  vendor    Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([productId, vendorId])
}

// ─── INVENTORY ──────────────────────────────────────
model Inventory {
  id           Int      @id @default(autoincrement())
  productId    Int      @unique
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int      @default(0)
  reorderPoint Int      @default(10)
  minimumStock Int      @default(5)
  location     String?
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

// ─── PURCHASE REQUESTS ──────────────────────────────
model PurchaseRequest {
  id            Int       @id @default(autoincrement())
  requestNo     String    @unique @default(cuid())
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  status        String    @default("Pending") // Pending, Approved, Rejected, RFQ_Sent, PO_Created
  priority      String    @default("Medium")  // Low, Medium, High, Urgent
  requiredDate  DateTime?
  estimatedCost Decimal?
  budgetCode    String?
  notes         String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
  rfqs           RFQ[]
  vendorQuotes   VendorQuote[]

  @@index([userId])
  @@index([status])
}

model PurchaseRequestItem {
  id          Int             @id @default(autoincrement())
  requestId   Int
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId   Int?            // Optional - null for custom product requests
  product     Product?        @relation(fields: [productId], references: [id])
  quantity    Int
  notes       String?
  // Custom product fields (used when productId is null)
  customProductName  String?  // Name of the new product being requested
  customProductDesc  String?  // Description of what is needed
  customEstimatedPrice Float? // Estimated price if known

  @@index([requestId])
}

// ─── REQUEST FOR QUOTATION (RFQ) ────────────────────
model RFQ {
  id          Int      @id @default(autoincrement())
  rfqNo       String   @unique @default(cuid())
  requestId   Int
  request     PurchaseRequest @relation(fields: [requestId], references: [id])
  status      String   @default("Open") // Open, Closed, Cancelled
  deadline    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations  Quotation[]
  vendors     RFQVendor[]  // Many-to-many: which vendors are invited

  @@index([requestId])
  @@index([status])
}

// RFQ-Vendor relationship (which vendors are invited to quote)
model RFQVendor {
  id        Int      @id @default(autoincrement())
  rfqId     Int
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  Int
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  status    String   @default("Invited") // Invited, Viewed, Quoted, Declined
  invitedAt DateTime @default(now())
  viewedAt  DateTime?
  respondedAt DateTime?

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
}

model Quotation {
  id              Int      @id @default(autoincrement())
  rfqId           Int
  rfq             RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId        Int
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  status          String   @default("Submitted") // Submitted, Selected, Rejected
  totalAmount     Float    @default(0)
  deliveryDays    Int?     // Estimated delivery in days
  validUntil      DateTime?
  terms           String?  // Payment/delivery terms
  notes           String?
  submittedAt     DateTime @default(now())

  items           QuotationItem[]
  purchaseOrders  PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id])
  // For custom products
  customProductName String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  @@index([quotationId])
}

// ─── PURCHASE ORDERS ────────────────────────────────
model PurchaseOrder {
  id               Int      @id @default(autoincrement())
  orderNo          String   @unique @default(cuid())
  requestId        Int
  request          PurchaseRequest @relation(fields: [requestId], references: [id])
  quotationId      Int?     // Link to selected quotation
  quotation        Quotation? @relation(fields: [quotationId], references: [id])
  vendorId         Int
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  status           String   @default("Draft") // Draft, Sent, Acknowledged, Completed, Cancelled
  totalAmount      Float    @default(0)
  paymentTerms     String?  // Net 30, Net 60
  shippingTerms    String?  // FOB, CIF
  taxAmount        Decimal  @default(0)
  sentToVendor     Boolean  @default(false)
  sentAt           DateTime?
  issuedAt         DateTime @default(now())
  expectedDelivery DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items          OrderItem[]
  goodsReceipts  GoodsReceipt[]
  invoices       Invoice[]
  returnOrders   ReturnOrder[]
  portalActions  VendorPortalAction[]

  @@index([vendorId])
  @@index([status])
}

model OrderItem {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  quantityOrdered Int
  priceEach       Float
  quantityReceived Int          @default(0)

  @@index([orderId])
}

// ─── GOODS RECEIPTS ─────────────────────────────────
model GoodsReceipt {
  id               Int           @id @default(autoincrement())
  receiptNo        String        @unique @default(cuid())
  orderId          Int
  order            PurchaseOrder @relation(fields: [orderId], references: [id])
  receivedBy       String?
  notes            String?
  inspectionStatus String?       // pending, passed, failed
  rejectionReason  String?
  receivedAt       DateTime      @default(now())

  items GoodsReceiptItem[]

  @@index([orderId])
}

model GoodsReceiptItem {
  id               Int          @id @default(autoincrement())
  receiptId        Int
  receipt          GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId        Int
  quantityReceived Int
  condition        String       @default("Good") // Good, Damaged, Partial

  @@index([receiptId])
}

// ─── INVOICES ───────────────────────────────────────
model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique
  orderId       Int
  order         PurchaseOrder @relation(fields: [orderId], references: [id])
  amount        Float
  taxAmount     Float         @default(0)
  totalAmount   Float
  status        String        @default("Pending") // Pending, Paid, Overdue
  invoiceDate   DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  payment       Payment?

  @@index([orderId])
  @@index([status])
}

// ─── WARRANTIES ─────────────────────────────────────
model Warranty {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  serialNo    String?
  provider    String?
  startDate   DateTime
  endDate     DateTime
  terms       String?
  status      String   @default("Active") // Active, Expired, Claimed
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([endDate])
}

// ─── SUBSCRIPTIONS ─────────────────────────────────
model Subscription {
  id            Int      @id @default(autoincrement())
  name          String
  vendor        String?
  type          String   @default("Software") // Software, Service, Support
  startDate     DateTime
  endDate       DateTime
  renewalCost   Float    @default(0)
  licenseCount  Int      @default(1)
  autoRenew     Boolean  @default(false)
  status        String   @default("Active") // Active, Expired, Cancelled
  notes         String?
  alertSent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([endDate])
  @@index([status])
}

// ─── NOTIFICATIONS ──────────────────────────────────
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─── AUDIT LOG ──────────────────────────────────────
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE, REJECT
  entity    String   // User, Vendor, Product, PurchaseRequest, etc.
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── CHATBOT ────────────────────────────────────────
model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  role      String   // user, assistant
  content   String
  metadata  String?  // JSON string for intent data
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── BUDGET ─────────────────────────────────────────
model Budget {
  id             Int      @id @default(autoincrement())
  department     String
  fiscalYear     String
  totalAmount    Decimal
  spentAmount    Decimal  @default(0)
  reservedAmount Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── VENDOR QUOTE ───────────────────────────────────
model VendorQuote {
  id           Int       @id @default(autoincrement())
  requestId    Int
  vendorId     Int
  unitPrice    Decimal
  deliveryDays Int?
  validityDate DateTime?
  notes        String?
  isSelected   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  
  request      PurchaseRequest @relation(fields: [requestId], references: [id])
  vendor       Vendor          @relation(fields: [vendorId], references: [id])

  @@index([requestId])
  @@index([vendorId])
}

// ─── PAYMENT ────────────────────────────────────────
model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int      @unique
  amount        Decimal
  paymentMethod String   // bank_transfer, check, card
  transactionId String?
  paymentDate   DateTime
  notes         String?
  
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
}

// ─── RETURN ORDER ───────────────────────────────────
model ReturnOrder {
  id         Int      @id @default(autoincrement())
  orderId    Int
  raisedBy   Int
  reason     String
  status     String   @default("pending")  // pending, approved, completed
  creditNote String?
  createdAt  DateTime @default(now())
  
  order      PurchaseOrder @relation(fields: [orderId], references: [id])
  user       User          @relation(fields: [raisedBy], references: [id])

  @@index([orderId])
  @@index([raisedBy])
}

// ─── VENDOR PORTAL ACTION ───────────────────────────
model VendorPortalAction {
  id        Int      @id @default(autoincrement())
  orderId   Int
  vendorId  Int
  action    String   // confirmed, rejected, change_requested
  message   String?  // vendor's note or reason
  createdAt DateTime @default(now())
  
  order     PurchaseOrder @relation(fields: [orderId], references: [id])
  vendor    Vendor        @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
}
