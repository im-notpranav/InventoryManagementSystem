generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ORDER CYCLE (v3)
//   PurchaseRequest (faculty + principal letter)
//     → HOD of same department approves / rejects
//     → VendorRFQ (invite any email, closing date)
//     → VendorQuoteSubmission + QuotationItem (price per item, delivery date)
//     → HOD selects one → WorkOrder (others auto-rejected)
//     → Shipment per delivery: invoice → dispatch (gate code) → GateCheck
//       → review (accepted / rejected qty, stock updated) → bill approved → paid
// ─────────────────────────────────────────────────────────────

model Role {
  role_id     Int    @id @default(autoincrement())
  role_name   String @unique
  permissions Json
  users       User[]
}

model User {
  user_id    Int      @id @default(autoincrement())
  role_id    Int
  name       String
  email      String   @unique
  password   String
  department String?
  phone      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  role                Role                    @relation(fields: [role_id], references: [role_id])
  vendor              Vendor?
  purchase_requests   PurchaseRequest[]
  approval_logs       ApprovalLog[]
  reviewed_quotes     VendorQuoteSubmission[] @relation("QuoteReviewer")
  created_work_orders WorkOrder[]             @relation("WOCreator")
  rfqs_sent           VendorRFQ[]             @relation("RFQSender")
  gate_checks         GateCheck[]             @relation("GateChecker")
  reviewed_shipments  Shipment[]              @relation("ShipmentReviewer")
  approved_bills      Shipment[]              @relation("BillApprover")
  paid_bills          Shipment[]              @relation("BillPayer")
  audit_logs          AuditLog[]
  notifications       Notification[]
}

model Vendor {
  vendor_id         Int       @id @default(autoincrement())
  user_id           Int?      @unique
  vendor_name       String
  company_name      String?
  email             String
  phone             String?
  address           String?
  rating            Float?
  performance_score Float?
  is_blacklisted    Boolean   @default(false)
  is_approved       Boolean   @default(true)
  status            String    @default("active") // active | invited | inactive
  invite_token      String?   @unique
  invite_expires_at DateTime?
  created_at        DateTime  @default(now())

  user              User?                   @relation(fields: [user_id], references: [user_id])
  quote_submissions VendorQuoteSubmission[]
  vendor_rfqs       VendorRFQ[]
  work_orders       WorkOrder[]
  warranties        Warranty[]
}

model Category {
  category_id Int       @id @default(autoincrement())
  name        String
  description String?
  products    Product[]
}

model Product {
  product_id    Int                   @id @default(autoincrement())
  category_id   Int
  sku           String                @unique
  name          String
  description   String?
  unit          String
  unit_price    Decimal
  is_active     Boolean               @default(true)
  category      Category              @relation(fields: [category_id], references: [category_id])
  inventory     Inventory[]
  warranties    Warranty[]
  request_items PurchaseRequestItem[]
}

// One stock row per product per department (see src/utils/departments.js).
model Inventory {
  inventory_id       Int      @id @default(autoincrement())
  product_id         Int
  department         String
  quantity_available Int      @default(0)
  reorder_point      Int
  min_stock          Int
  max_stock          Int
  last_updated       DateTime @updatedAt
  product            Product  @relation(fields: [product_id], references: [product_id])

  @@unique([product_id, department])
  @@index([department])
}

// status: pending → approved | rejected → rfq_sent → wo_issued → in_delivery → completed
model PurchaseRequest {
  request_id    Int       @id @default(autoincrement())
  pr_number     String?   @unique
  requested_by  Int
  letter_url    String? // principal's letter; null only on pre-v3 (legacy) requests
  required_date DateTime?
  status        String    @default("pending")
  requested_at  DateTime  @default(now())
  admin_remarks String?
  rfq_closes_at DateTime?

  user              User                    @relation(fields: [requested_by], references: [user_id])
  approval_logs     ApprovalLog[]
  vendor_rfqs       VendorRFQ[]
  quote_submissions VendorQuoteSubmission[]
  work_orders       WorkOrder[]
  items             PurchaseRequestItem[]
}

model PurchaseRequestItem {
  item_id        Int             @id @default(autoincrement())
  request_id     Int
  product_id     Int
  quantity       Int
  notes          String? // optional specification for vendors
  request        PurchaseRequest @relation(fields: [request_id], references: [request_id])
  product        Product         @relation(fields: [product_id], references: [product_id])
  quote_items    QuotationItem[]
  shipment_items ShipmentItem[]
}

model ApprovalLog {
  log_id      Int             @id @default(autoincrement())
  request_id  Int
  approver_id Int
  action      String
  comments    String?
  acted_at    DateTime        @default(now())
  request     PurchaseRequest @relation(fields: [request_id], references: [request_id])
  approver    User            @relation(fields: [approver_id], references: [user_id])
}

model VendorRFQ {
  rfq_id     Int             @id @default(autoincrement())
  request_id Int
  vendor_id  Int
  sent_by    Int
  sent_at    DateTime        @default(now())
  status     String          @default("pending") // pending | submitted
  request    PurchaseRequest @relation(fields: [request_id], references: [request_id])
  vendor     Vendor          @relation(fields: [vendor_id], references: [vendor_id])
  sender     User            @relation("RFQSender", fields: [sent_by], references: [user_id])
}

// status: pending → selected | rejected
model VendorQuoteSubmission {
  submission_id      Int       @id @default(autoincrement())
  request_id         Int
  vendor_id          Int
  quotation_file_url String
  total_price        Decimal
  expected_delivery  DateTime?
  notes              String?
  status             String    @default("pending")
  admin_remarks      String?
  submitted_at       DateTime  @default(now())
  reviewed_at        DateTime?
  reviewed_by        Int?

  request    PurchaseRequest @relation(fields: [request_id], references: [request_id])
  vendor     Vendor          @relation(fields: [vendor_id], references: [vendor_id])
  reviewer   User?           @relation("QuoteReviewer", fields: [reviewed_by], references: [user_id])
  items      QuotationItem[]
  work_order WorkOrder?
}

model QuotationItem {
  quote_item_id   Int                   @id @default(autoincrement())
  submission_id   Int
  request_item_id Int
  unit_price      Decimal
  submission      VendorQuoteSubmission @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade)
  request_item    PurchaseRequestItem   @relation(fields: [request_item_id], references: [item_id])

  @@unique([submission_id, request_item_id])
}

// status: issued → in_delivery → completed
model WorkOrder {
  wo_id             Int      @id @default(autoincrement())
  wo_number         String   @unique
  submission_id     Int      @unique
  request_id        Int
  vendor_id         Int
  created_by        Int
  agreed_price      Decimal
  delivery_deadline DateTime
  terms             String?
  status            String   @default("issued")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  submission VendorQuoteSubmission @relation(fields: [submission_id], references: [submission_id])
  request    PurchaseRequest       @relation(fields: [request_id], references: [request_id])
  vendor     Vendor                @relation(fields: [vendor_id], references: [vendor_id])
  creator    User                  @relation("WOCreator", fields: [created_by], references: [user_id])
  shipments  Shipment[]
  warranties Warranty[]
}

// One delivery against a work order.
// status: invoiced → dispatched → (gate_blocked ↺ dispatched) → received
//         → reviewed → bill_approved → paid        (or rejected when 0 qty accepted)
model Shipment {
  shipment_id     Int    @id @default(autoincrement())
  shipment_number String @unique
  wo_id           Int
  status          String @default("invoiced")

  // 1. invoice (vendor)
  invoice_number String
  invoice_url    String
  invoice_amount Decimal
  invoiced_at    DateTime @default(now())

  // 2. dispatch (vendor)
  vehicle_number   String?
  expected_arrival DateTime?
  num_packages     Int?
  dispatched_at    DateTime?
  gate_code        String? // 6-digit code, also encoded in the gate pass QR

  // 3. gate (watchman)
  received_at DateTime?

  // 4. review (faculty or HOD)
  reviewed_by     Int?
  reviewed_at     DateTime?
  review_remarks  String?
  billable_amount Decimal?

  // 5. billing (accountant)
  bill_approved_by   Int?
  bill_approved_at   DateTime?
  accountant_remarks String?
  paid_by            Int?
  payment_date       DateTime?
  payment_mode       String?
  payment_ref        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  wo          WorkOrder      @relation(fields: [wo_id], references: [wo_id])
  items       ShipmentItem[]
  gate_checks GateCheck[]
  warranties  Warranty[]
  reviewer    User?          @relation("ShipmentReviewer", fields: [reviewed_by], references: [user_id])
  approver    User?          @relation("BillApprover", fields: [bill_approved_by], references: [user_id])
  payer       User?          @relation("BillPayer", fields: [paid_by], references: [user_id])

  @@index([gate_code])
}

model ShipmentItem {
  shipment_item_id Int                 @id @default(autoincrement())
  shipment_id      Int
  request_item_id  Int
  qty_shipped      Int
  qty_accepted     Int? // set at review; rejected = shipped - accepted
  unit_price       Decimal
  shipment         Shipment            @relation(fields: [shipment_id], references: [shipment_id], onDelete: Cascade)
  request_item     PurchaseRequestItem @relation(fields: [request_item_id], references: [item_id])
}

model GateCheck {
  check_id    Int      @id @default(autoincrement())
  shipment_id Int
  checked_by  Int
  result      String // match | mismatch
  reason      String?
  photo_url   String?
  checked_at  DateTime @default(now())
  shipment    Shipment @relation(fields: [shipment_id], references: [shipment_id], onDelete: Cascade)
  checker     User     @relation("GateChecker", fields: [checked_by], references: [user_id])
}

// Warranty and subscription tracker (see src/utils/tracker.js).
// last_reminder: smallest reminder stage already sent (30, 7, 1 or 0 = expired);
// null = none yet. Renewing resets it to null.
model Warranty {
  warranty_id   Int        @id @default(autoincrement())
  product_id    Int
  vendor_id     Int?
  wo_id         Int?
  shipment_id   Int?
  department    String
  serial_number String?
  quantity      Int        @default(1)
  start_date    DateTime
  end_date      DateTime
  notes         String?
  document_url  String?
  last_reminder Int?
  created_by    Int?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  product       Product    @relation(fields: [product_id], references: [product_id])
  vendor        Vendor?    @relation(fields: [vendor_id], references: [vendor_id])
  wo            WorkOrder? @relation(fields: [wo_id], references: [wo_id])
  shipment      Shipment?  @relation(fields: [shipment_id], references: [shipment_id])

  @@index([department])
  @@index([end_date])
}

// Software licence or recurring service (Microsoft 365, Photoshop, Claude, ...).
// Standalone: not linked to an inventory product.
// billing_cycle: monthly | quarterly | yearly | one_time
model Subscription {
  subscription_id Int       @id @default(autoincrement())
  service_name    String
  provider        String?
  plan            String?
  department      String
  seats           Int?
  cost            Decimal?
  billing_cycle   String    @default("yearly")
  start_date      DateTime?
  expiry_date     DateTime
  auto_renew      Boolean   @default(false)
  notes           String?
  document_url    String?
  last_reminder   Int?
  renewed_at      DateTime?
  created_by      Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([department])
  @@index([expiry_date])
}

model AuditLog {
  audit_id   Int      @id @default(autoincrement())
  user_id    Int
  table_name String
  action     String
  old_value  Json?
  new_value  Json?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [user_id])
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  type            String
  message         String
  link            String? // in-app path opened when the notification is clicked
  is_read         Boolean  @default(false)
  sent_at         DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id, sent_at])
}

model Budget {
  budget_id       Int      @id @default(autoincrement())
  department      String
  fiscal_year     String
  total_amount    Decimal
  spent_amount    Decimal  @default(0)
  reserved_amount Decimal  @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}
